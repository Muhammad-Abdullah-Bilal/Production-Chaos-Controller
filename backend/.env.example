# Production Chaos Controller - Backend Environment Configuration

PROJECT_NAME="Production Chaos Controller API"
ENVIRONMENT="development"
DEBUG=true
API_V1_PREFIX="/api/v1"
CORS_ORIGINS='["http://localhost:3000", "http://127.0.0.1:3000"]'

HOST="0.0.0.0"
PORT=8000

# Google Gemini / Google Cloud Agent Builder Configuration
GEMINI_API_KEY=""
GOOGLE_CLOUD_PROJECT=""
GOOGLE_CLOUD_LOCATION="us-central1"

# ClickHouse Configuration (Hackathon Partner Integration)
CLICKHOUSE_HOST="localhost"
CLICKHOUSE_PORT=8123
CLICKHOUSE_USER="default"
CLICKHOUSE_PASSWORD=""
CLICKHOUSE_DB="production_chaos"
