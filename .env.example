# Production Chaos Controller - Root Environment Configuration

# Google Gemini / Google Cloud Agent Builder Configuration
GEMINI_API_KEY=""
GOOGLE_CLOUD_PROJECT=""
GOOGLE_CLOUD_LOCATION="us-central1"

# ClickHouse Integration Configuration (Official ClickHouse MCP Integration)
CLICKHOUSE_HOST="localhost"
CLICKHOUSE_PORT=8123
CLICKHOUSE_USER="default"
CLICKHOUSE_PASSWORD=""
CLICKHOUSE_DB="production_chaos"
CLICKHOUSE_SECURE=false
CLICKHOUSE_ENABLED=true

# Next.js Frontend Configuration
NEXT_PUBLIC_API_BASE_URL="http://localhost:8000"
